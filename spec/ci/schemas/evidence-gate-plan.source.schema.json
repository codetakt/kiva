{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiva:ci:evidence-gate-plan-source:1",
  "title": "Kiva CI evidence gate plan source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "compatibility_view", "group_source", "synchronization_policy", "groups"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "kiva-ci-evidence-gate-plan-source" },
    "status": { "const": "active" },
    "description": { "type": "string", "minLength": 1 },
    "compatibility_view": { "type": "string", "minLength": 1 },
    "group_source": { "type": "string", "minLength": 1 },
    "synchronization_policy": { "const": "normal-form-primary-with-evidence-check-compatibility-view" },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "nix_gate", "claim_boundary", "check_order"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "nix_gate": { "type": "string", "minLength": 1 },
          "claim_boundary": { "type": "string", "minLength": 1 },
          "check_order": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
