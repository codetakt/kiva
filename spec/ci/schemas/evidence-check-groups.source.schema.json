{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiva:ci:evidence-check-groups-source:1",
  "title": "Kiva evidence-check groups source",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "kind", "status", "groups"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "kiva-ci-evidence-check-groups-source" },
    "status": { "const": "active" },
    "description": { "type": "string", "minLength": 1 },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nix_gate", "claim_boundary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "nix_gate": { "type": "string", "minLength": 1 },
          "claim_boundary": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
