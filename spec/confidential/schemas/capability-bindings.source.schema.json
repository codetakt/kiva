{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiva:confidential:capability-bindings-source:1",
  "title": "Kiva confidential CapabilityBinding source",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "kind",
    "status",
    "operation_kernel",
    "taxonomy_source",
    "generated_artifacts",
    "binding_model",
    "bindings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "kiva-confidential-capability-bindings-source" },
    "status": { "const": "active" },
    "operation_kernel": { "type": "string", "minLength": 1 },
    "taxonomy_source": { "type": "string", "minLength": 1 },
    "generated_artifacts": { "type": "object" },
    "binding_model": { "type": "object" },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "maturity_mechanism",
          "capability",
          "boundary_note"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "maturity_mechanism": { "type": "string", "minLength": 1 },
          "capability": { "type": "string", "minLength": 1 },
          "binding_kind": { "type": "string", "minLength": 1 },
          "operation_selector": {
            "type": "object",
            "required": ["workflow_families"],
            "properties": {
              "workflow_families": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": true
          },
          "boundary_note": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    }
  }
}
