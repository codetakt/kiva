{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiva:confidential:mechanism-catalog-source:1",
  "title": "Kiva confidential mechanism catalog source",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "kind", "status", "maturity_ledger", "provider_contract", "provider_algebra", "mechanisms"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "kiva-confidential-mechanism-catalog-source" },
    "status": { "const": "active" },
    "maturity_ledger": { "type": "string", "minLength": 1 },
    "provider_contract": { "type": "string", "minLength": 1 },
    "provider_algebra": {
      "type": "object",
      "required": ["mechanism_field", "provider_kind_field", "capability_field", "production_gate_field"],
      "properties": {
        "mechanism_field": { "const": "maturity_mechanism" },
        "provider_kind_field": { "const": "provider_kind" },
        "capability_field": { "const": "required_provider_capability" },
        "production_gate_field": { "const": "production_provider_review_required" }
      },
      "additionalProperties": true
    },
    "mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "technique", "provider_kind", "required_provider_capability", "production_provider_review_required", "requires_all_participants", "maturity_mechanism"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "technique": { "type": "string", "minLength": 1 },
          "provider_kind": { "type": "string", "minLength": 1 },
          "required_provider_capability": { "type": "string", "minLength": 1 },
          "production_provider_review_required": { "type": "boolean" },
          "requires_all_participants": { "type": "boolean" },
          "maturity_mechanism": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    }
  }
}
