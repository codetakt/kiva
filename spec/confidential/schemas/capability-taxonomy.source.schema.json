{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiva:confidential:capability-taxonomy-source:1",
  "title": "Kiva confidential capability taxonomy source",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "kind", "status", "capabilities"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "kiva-confidential-capability-taxonomy-source" },
    "status": { "const": "active" },
    "description": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "binding_kind", "workflow_families"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "binding_kind": { "type": "string", "minLength": 1 },
          "workflow_families": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
