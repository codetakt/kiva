{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiva:verification:obligations-source:1",
  "title": "Kiva verification obligations source",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "kind", "status", "source_ledger", "generated_artifacts", "obligation_model"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "kiva-verification-obligations-source" },
    "status": { "const": "active" },
    "source_ledger": { "type": "string", "minLength": 1 },
    "generated_artifacts": { "type": "object" },
    "obligation_model": {
      "type": "object",
      "required": ["root_type", "property_first", "tool_neutral", "discharge_methods", "method_fields"],
      "properties": {
        "root_type": { "const": "VerificationObligation" },
        "property_first": { "const": true },
        "tool_neutral": { "const": true },
        "discharge_methods": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "method_fields": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
