{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiva:evidence:executed-receipts-source:1",
  "title": "Kiva executed receipts source",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "kind", "status", "inputs", "generated_artifacts", "run_model"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "kiva-executed-receipts-source" },
    "status": { "const": "active" },
    "description": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_receipts", "evidence_manifest"],
      "properties": {
        "declared_receipts": { "type": "string", "minLength": 1 },
        "evidence_manifest": { "type": "string", "minLength": 1 }
      }
    },
    "generated_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlay", "markdown"],
      "properties": {
        "overlay": { "type": "string", "minLength": 1 },
        "markdown": { "type": "string", "minLength": 1 }
      }
    },
    "run_model": {
      "type": "object",
      "additionalProperties": true,
      "required": ["root_type", "committed_overlay_status", "executed_status", "rule"],
      "properties": {
        "root_type": { "const": "ReceiptRun" },
        "committed_overlay_status": { "type": "string", "minLength": 1 },
        "executed_status": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 }
      }
    }
  }
}
