{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiva:evidence:executed-receipt-overlay:1",
  "title": "Kiva executed receipt overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "status",
    "description",
    "generated_from",
    "generated_artifacts",
    "run_model",
    "summary",
    "receipt_runs",
    "executed_receipts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "kiva-executed-receipt-overlay" },
    "status": { "const": "active" },
    "description": { "type": "string", "minLength": 1 },
    "generated_from": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "generated_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlay", "markdown"],
      "properties": {
        "overlay": { "type": "string", "minLength": 1 },
        "markdown": { "type": "string", "minLength": 1 }
      }
    },
    "run_model": { "type": "object", "additionalProperties": true },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_evidence_receipt_count",
        "declared_verification_receipt_count",
        "receipt_run_count",
        "executed_receipt_count"
      ],
      "properties": {
        "declared_evidence_receipt_count": { "type": "integer", "minimum": 0 },
        "declared_verification_receipt_count": { "type": "integer", "minimum": 0 },
        "receipt_run_count": { "type": "integer", "minimum": 0 },
        "executed_receipt_count": { "type": "integer", "minimum": 0 }
      }
    },
    "receipt_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "root_type", "status", "report_path", "report_sha256", "report_kind", "check_count"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "root_type": { "const": "ReceiptRun" },
          "status": { "type": "string", "minLength": 1 },
          "report_path": { "type": "string", "minLength": 1 },
          "report_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "report_kind": { "type": "string", "minLength": 1 },
          "check_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "executed_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "root_type", "status", "receipt_id", "check_ref", "run_id", "report_sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "root_type": { "const": "ExecutedReceipt" },
          "status": { "type": "string", "minLength": 1 },
          "receipt_id": { "type": "string", "minLength": 1 },
          "check_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["group", "check_id"],
            "properties": {
              "group": { "type": "string", "minLength": 1 },
              "check_id": { "type": "string", "minLength": 1 }
            }
          },
          "run_id": { "type": "string", "minLength": 1 },
          "report_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
