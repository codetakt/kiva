{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiva:conformance:endpoint-profile:1",
  "title": "Kiva xAPI LRS conformance endpoint profile fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "standard",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "standard": {
      "const": "IEEE/ISO/IEC 39274-1-1-2025"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "deterministic-too-large-threshold": {
          "$ref": "#/$defs/tooLargeProfile"
        },
        "deterministic-rate-limit-trigger": {
          "$ref": "#/$defs/rateLimitProfile"
        },
        "declared-parameter-vocabulary": {
          "$ref": "#/$defs/parameterVocabulary"
        },
        "declared-resource-absence": {
          "$ref": "#/$defs/resourceAbsence"
        },
        "signature-validation-context": {
          "$ref": "#/$defs/signatureContext"
        }
      }
    }
  },
  "$defs": {
    "tooLargeProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_request_body_bytes",
        "probe_body_bytes"
      ],
      "properties": {
        "max_request_body_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "probe_body_bytes": {
          "type": "integer",
          "minimum": 2,
          "maximum": 16777216
        }
      }
    },
    "rateLimitProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_count",
        "window_seconds",
        "path"
      ],
      "properties": {
        "request_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "parameterVocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contexts"
      ],
      "properties": {
        "contexts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "path",
              "evidence",
              "unrecognized"
            ],
            "properties": {
              "method": {
                "enum": [
                  "GET",
                  "HEAD",
                  "PUT",
                  "POST",
                  "DELETE"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "evidence": {
                "type": "string",
                "pattern": "\\S"
              },
              "unrecognized": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "resourceAbsence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_evidence"
      ],
      "properties": {
        "case_evidence": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "\\S"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "\\S"
          },
          "description": "Independent fixture evidence keyed by exact current case id. Establish absence of every negatively queried Statement/document selector under the request credentials immediately before that case and maintain it throughout. A fresh/isolated label or the response under test is not evidence. The runner checks availability; fixture validity/integration is a later stage."
        }
      }
    },
    "signatureContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signature"
      ],
      "properties": {
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence",
            "algorithms",
            "certificate_signature",
            "without_certificate"
          ],
          "properties": {
            "evidence": {
              "type": "string",
              "minLength": 1
            },
            "algorithms": {
              "const": [
                "RS256",
                "RS384",
                "RS512"
              ]
            },
            "certificate_signature": {
              "const": "verify-supplied-x5c"
            },
            "without_certificate": {
              "const": "accept-without-cryptographic-verification"
            }
          }
        }
      }
    }
  }
}
