{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiva:architecture:claim-graph:1",
  "title": "Kiva ClaimGraph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "status",
    "description",
    "generated_from",
    "generated_artifacts",
    "graph_model",
    "summary",
    "claims",
    "capability_bindings",
    "verification_obligations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "kiva-claim-graph" },
    "status": { "const": "active" },
    "description": { "type": "string", "minLength": 1 },
    "generated_from": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "generated_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_graph", "markdown"],
      "properties": {
        "claim_graph": { "type": "string", "minLength": 1 },
        "markdown": { "type": "string", "minLength": 1 }
      }
    },
    "graph_model": { "type": "object", "additionalProperties": true },
    "summary": { "type": "object", "additionalProperties": true },
    "claims": { "type": "array", "items": { "type": "object" } },
    "capability_bindings": { "type": "array", "items": { "type": "object" } },
    "verification_obligations": { "type": "array", "items": { "type": "object" } }
  }
}
