{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiva:architecture:architecture-graph-source:1",
  "title": "Kiva ArchitectureGraph source",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "kind", "status", "projection_policy", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "kiva-architecture-graph-source" },
    "status": { "const": "active" },
    "projection_policy": {
      "type": "object",
      "required": ["architecture_policy_source", "projection_spec_source"],
      "properties": {
        "architecture_policy_source": { "type": "string", "minLength": 1 },
        "projection_spec_source": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["owner", "purpose"],
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "artifacts": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
