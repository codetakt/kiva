        "scope": {
          "$ref": "#/$defs/ConsentScope"
        },
        "state": {
          "$ref": "#/$defs/ConsentState"
        }
      },
      "required": [
        "grantId",
        "dataSubject",
        "granteeSubject",
        "scope",
        "state",
        "purpose",
        "legalBasis",
        "createdAt"
      ],
      "type": "object"
    },
    "ConsentGrantList": {
      "additionalProperties": false,
      "properties": {
        "grants": {
          "items": {
            "$ref": "#/$defs/ConsentGrant"
          },
          "type": "array"
        }
      },
      "required": [
        "grants"
      ],
      "type": "object"
    },
    "ConsentGrantRequest": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "grant_id": {
          "$ref": "#/$defs/Uuid"
        },
        "grantee_subject": {
          "minLength": 1,
          "type": "string"
        },
        "legal_basis": {
          "$ref": "#/$defs/LegalBasis"
        },
        "purpose": {
          "minLength": 1,
          "type": "string"
        },
        "renewed_from_grant_id": {
          "$ref": "#/$defs/Uuid"
        },
        "scope": {
          "$ref": "#/$defs/ConsentScope"
        }
      },
      "required": [
        "grant_id",
        "grantee_subject",
        "scope",
        "purpose",
        "legal_basis"
      ],
      "type": "object"
    },
    "ConsentRevocationRequest": {
      "additionalProperties": false,
      "properties": {
        "grant_id": {
          "$ref": "#/$defs/Uuid"
        }
      },
      "required": [
        "grant_id"
      ],
      "type": "object"
    },
    "ConsentScope": {
      "enum": [
        "raw-records",
        "personal-data",
        "aggregate-insights"
      ],
      "type": "string"
    },
    "ConsentState": {
      "enum": [
        "active",
        "revoked"
      ],
      "type": "string"
    },
    "DataClass": {
      "enum": [
        "statement-metadata",
        "consent-metadata",
        "data-product-metadata",
        "access-audit-metadata",
        "lifecycle-metadata"
      ],
      "type": "string"
    },
    "DataProduct": {
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "dataClasses": {
          "items": {
            "$ref": "#/$defs/DataClass"
          },
          "minItems": 1,
          "type": "array"
        },
        "dataProductId": {
          "$ref": "#/$defs/Uuid"
        },
        "legalBasis": {
          "$ref": "#/$defs/LegalBasis"
        },
        "ownerSubject": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "releaseArtifact": {
          "$ref": "#/$defs/ReleaseArtifactRef"
