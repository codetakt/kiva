        "decision": {
          "$ref": "#/$defs/PolicyDecision"
        },
        "denyReason": {
          "type": "string"
        },
        "eventId": {
          "$ref": "#/$defs/Uuid"
        },
        "grantId": {
          "$ref": "#/$defs/Uuid"
        },
        "requesterSubject": {
          "type": "string"
        },
        "resource": {
          "$ref": "#/$defs/ResourceClass"
        },
        "role": {
          "$ref": "#/$defs/PrincipalRole"
        }
      },
      "required": [
        "eventId",
        "requesterSubject",
        "role",
        "resource",
        "action",
        "decision",
        "createdAt"
