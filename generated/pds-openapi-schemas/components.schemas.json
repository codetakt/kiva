          "items": {
            "$ref": "#/$defs/ConsentGrant"
          },
          "type": "array"
        },
        "dataProducts": {
          "items": {
            "$ref": "#/$defs/DataProduct"
          },
          "type": "array"
        },
        "dataSubject": {
          "type": "string"
        },
        "generatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "governanceProfiles": {
          "items": {
            "$ref": "#/$defs/GovernanceProfile"
          },
          "type": "array"
        },
        "lifecycleCases": {
          "items": {
            "$ref": "#/$defs/LifecycleCase"
          },
          "type": "array"
        },
        "lifecycleEvents": {
