          },
          "type": "array"
        },
        "dataProducts": {
          "items": {
            "$ref": "#/$defs/DataProduct"
          },
          "type": "array"
        },
        "dataSubject": {
          "type": "string"
        },
        "generatedAt": {
          "format": "date-time",
