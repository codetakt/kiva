      "enum": [
        "write",
        "read",
        "delegate",
        "revoke",
        "compute",
        "release",
        "audit"
      ],
      "type": "string"
    },
    "PolicyDecision": {
      "enum": [
        "allow",
        "deny"
      ],
      "type": "string"
    },
