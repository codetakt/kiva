        "event_type": {
          "$ref": "#/$defs/LifecycleEventType"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "resource_id": {
          "minLength": 1,
          "type": "string"
        },
        "resource_kind": {
          "$ref": "#/$defs/LifecycleResourceKind"
        }
      },
      "required": [
        "event_id",
        "event_type",
        "resource_kind",
        "resource_id",
        "reason"
      ],
      "type": "object"
    },
