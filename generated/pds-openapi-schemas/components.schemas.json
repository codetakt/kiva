      "required": [
        "case_id",
        "case_type",
        "resource_kind",
        "resource_id",
        "status",
        "summary"
      ],
      "type": "object"
    },
    "LifecycleCaseStatus": {
      "enum": [
        "open",
        "under-review",
        "resolved",
        "rejected",
        "tombstoned"
      ],
      "type": "string"
    },
    "LifecycleCaseType": {
      "enum": [
        "correction",
        "dispute",
        "tombstone"
      ],
      "type": "string"
    },
    "LifecycleEvent": {
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "format": "date-time",
