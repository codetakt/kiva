        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "dataCustodianSubject": {
          "type": "string"
        },
        "emergencyAccessPolicy": {
          "type": "string"
        },
        "identityAuthoritySubject": {
          "type": [
            "string",
            "null"
          ]
        },
        "platformOperatorSubject": {
          "type": "string"
        },
        "policyAuthoritySubject": {
          "type": "string"
        },
        "profileId": {
          "$ref": "#/$defs/Uuid"
        },
        "profileKind": {
          "$ref": "#/$defs/GovernanceProfileKind"
        },
        "profileOwnerSubject": {
          "type": "string"
        },
        "runbookRefs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "subjectPartition": {
          "type": "string"
        },
        "tenantPartition": {
          "type": "string"
        }
