        "resource_id": {
          "minLength": 1,
          "type": "string"
        },
        "resource_kind": {
          "$ref": "#/$defs/LifecycleResourceKind"
        },
        "retention_policy_id": {
          "$ref": "#/$defs/Uuid"
        },
        "status": {
          "$ref": "#/$defs/LifecycleCaseStatus"
        },
        "summary": {
          "minLength": 1,
          "type": "string"
