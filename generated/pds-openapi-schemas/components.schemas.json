        },
        "grant_id": {
          "$ref": "#/$defs/Uuid"
        },
        "resource": {
          "$ref": "#/$defs/ResourceClass"
        },
        "role": {
          "$ref": "#/$defs/PrincipalRole"
        }
      },
      "required": [
        "role",
        "resource",
        "action"
      ],
      "type": "object"
    },
    "AccessCheckResponse": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "#/$defs/PolicyDecision"
        },
        "denyReason": {
          "type": "string"
        },
        "eventId": {
          "$ref": "#/$defs/Uuid"
        }
      },
      "required": [
        "eventId",
        "decision"
      ],
      "type": "object"
    },
    "ConfidentialMechanismKind": {
      "enum": [
        "additive-n-of-n",
        "private-set-intersection",
        "private-set-intersection-oprf-dh",
        "shamir-threshold",
        "threshold-frost-signing",
        "trusted-execution-environment",
        "trusted-execution-environment-aws-nitro",
        "fhe-sum-feasibility",
        "fhe-sum-runtime"
      ],
      "type": "string"
    },
    "ConsentGrant": {
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "dataSubject": {
          "type": "string"
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "grantId": {
          "$ref": "#/$defs/Uuid"
        },
        "granteeSubject": {
          "type": "string"
        },
        "legalBasis": {
          "$ref": "#/$defs/LegalBasis"
        },
        "purpose": {
          "type": "string"
        },
        "renewedFromGrantId": {
          "$ref": "#/$defs/Uuid"
