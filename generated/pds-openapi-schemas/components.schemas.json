        "title": {
          "type": "string"
        }
      },
      "required": [
        "dataProductId",
        "ownerSubject",
        "sourceKind",
        "releaseId",
        "releaseArtifact",
        "title",
        "purpose",
        "legalBasis",
        "dataClasses",
        "createdAt"
      ],
      "type": "object"
    },
    "DataProductList": {
      "additionalProperties": false,
      "properties": {
        "dataProducts": {
          "items": {
            "$ref": "#/$defs/DataProduct"
          },
          "type": "array"
        }
      },
      "required": [
        "dataProducts"
      ],
      "type": "object"
    },
    "DataProductReadRequest": {
      "additionalProperties": false,
      "properties": {
        "data_product_id": {
          "$ref": "#/$defs/Uuid"
        },
        "grant_id": {
          "$ref": "#/$defs/Uuid"
        }
      },
      "required": [
        "grant_id",
        "data_product_id"
      ],
      "type": "object"
    },
    "DataProductReadResponse": {
      "additionalProperties": false,
      "properties": {
        "dataProduct": {
          "$ref": "#/$defs/DataProduct"
        },
        "decision": {
          "$ref": "#/$defs/PolicyDecision"
        },
        "denyReason": {
          "type": "string"
        },
        "eventId": {
          "$ref": "#/$defs/Uuid"
        }
      },
      "required": [
        "eventId",
        "decision"
      ],
      "type": "object"
    },
    "DataProductRequest": {
      "additionalProperties": false,
      "properties": {
        "data_classes": {
          "items": {
            "$ref": "#/$defs/DataClass"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "data_product_id": {
          "$ref": "#/$defs/Uuid"
        },
        "legal_basis": {
          "$ref": "#/$defs/LegalBasis"
        },
        "purpose": {
          "minLength": 1,
          "type": "string"
        },
        "release_id": {
          "$ref": "#/$defs/Hex32"
        },
        "source_kind": {
          "$ref": "#/$defs/DataProductSourceKind"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "data_product_id",
        "source_kind",
        "release_id",
        "title",
        "purpose",
        "legal_basis",
        "data_classes"
      ],
      "type": "object"
    },
    "DataProductSourceKind": {
      "enum": [
        "threshold-release",
        "differential-privacy-release",
        "shamir-threshold-reconstruction"
      ],
      "type": "string"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "GovernanceProfile": {
      "additionalProperties": false,
      "properties": {
        "analystSubject": {
          "type": "string"
        },
        "auditorSubject": {
          "type": "string"
