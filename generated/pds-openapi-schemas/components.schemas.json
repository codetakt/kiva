        "eventId": {
          "$ref": "#/$defs/Uuid"
        },
        "eventType": {
          "$ref": "#/$defs/LifecycleEventType"
        },
        "reason": {
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        },
        "resourceKind": {
          "$ref": "#/$defs/LifecycleResourceKind"
        }
      },
      "required": [
        "eventId",
        "dataSubject",
        "eventType",
        "resourceKind",
        "resourceId",
        "reason",
        "createdAt"
      ],
      "type": "object"
    },
    "LifecycleEventList": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/LifecycleEvent"
          },
          "type": "array"
        }
      },
      "required": [
        "events"
      ],
      "type": "object"
    },
