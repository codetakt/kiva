    },
    "AccessAuditEventList": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/AccessAuditEvent"
          },
          "type": "array"
        }
      },
      "required": [
        "events"
      ],
      "type": "object"
    },
    "AccessCheckRequest": {
      "additionalProperties": false,
