      "required": [
        "profileId",
        "profileOwnerSubject",
        "profileKind",
        "tenantPartition",
        "subjectPartition",
        "dataCustodianSubject",
        "platformOperatorSubject",
        "policyAuthoritySubject",
        "analystSubject",
        "auditorSubject",
        "emergencyAccessPolicy",
        "runbookRefs",
        "createdAt"
      ],
      "type": "object"
    },
    "GovernanceProfileKind": {
      "enum": [
        "single-operator",
        "school-district",
        "multi-agency"
      ],
      "type": "string"
    },
    "GovernanceProfileList": {
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "items": {
            "$ref": "#/$defs/GovernanceProfile"
          },
          "type": "array"
        }
      },
      "required": [
        "profiles"
      ],
      "type": "object"
    },
    "GovernanceProfileRequest": {
      "additionalProperties": false,
      "properties": {
        "analyst_subject": {
          "minLength": 1,
          "type": "string"
        },
        "auditor_subject": {
          "minLength": 1,
          "type": "string"
        },
        "data_custodian_subject": {
          "minLength": 1,
          "type": "string"
        },
        "emergency_access_policy": {
          "minLength": 1,
          "type": "string"
        },
        "identity_authority_subject": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "platform_operator_subject": {
          "minLength": 1,
          "type": "string"
        },
        "policy_authority_subject": {
          "minLength": 1,
          "type": "string"
        },
        "profile_id": {
          "$ref": "#/$defs/Uuid"
        },
        "profile_kind": {
          "$ref": "#/$defs/GovernanceProfileKind"
        },
        "runbook_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "subject_partition": {
          "minLength": 1,
          "type": "string"
        },
        "tenant_partition": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "profile_kind",
        "tenant_partition",
        "subject_partition",
        "data_custodian_subject",
        "platform_operator_subject",
        "policy_authority_subject",
        "analyst_subject",
        "auditor_subject",
        "emergency_access_policy",
        "runbook_refs"
      ],
      "type": "object"
    },
    "Hex32": {
      "pattern": "^[0-9a-fA-F]{64}$",
      "type": "string"
    },
    "LegalBasis": {
      "enum": [
        "consent",
        "public-task",
        "legitimate-interest",
        "contract",
        "legal-obligation"
      ],
      "type": "string"
    },
    "LifecycleCase": {
      "additionalProperties": false,
      "properties": {
        "caseId": {
          "$ref": "#/$defs/Uuid"
        },
        "caseType": {
          "$ref": "#/$defs/LifecycleCaseType"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "dataSubject": {
          "type": "string"
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        },
        "resourceId": {
          "type": "string"
        },
        "resourceKind": {
          "$ref": "#/$defs/LifecycleResourceKind"
        },
        "retentionPolicyId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/LifecycleCaseStatus"
        },
        "summary": {
          "type": "string"
        },
        "tombstonePublication": {
          "anyOf": [
            {
              "$ref": "#/$defs/TombstonePublicationRule"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "caseId",
        "dataSubject",
        "caseType",
        "resourceKind",
        "resourceId",
        "status",
        "summary",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    },
    "LifecycleCaseList": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "items": {
            "$ref": "#/$defs/LifecycleCase"
