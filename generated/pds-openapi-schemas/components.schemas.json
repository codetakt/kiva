        "lifecycleEvents": {
          "items": {
            "$ref": "#/$defs/LifecycleEvent"
          },
          "type": "array"
        },
        "recordInventory": {
          "$ref": "#/$defs/RecordInventory"
        },
        "retentionPolicies": {
          "items": {
            "$ref": "#/$defs/RetentionPolicy"
          },
          "type": "array"
        }
      },
      "required": [
        "dataSubject",
        "actor",
        "actorIfi",
        "generatedAt",
        "recordInventory",
        "consentGrants",
        "dataProducts",
        "lifecycleEvents",
        "retentionPolicies",
        "lifecycleCases",
        "governanceProfiles"
      ],
      "type": "object"
    },
