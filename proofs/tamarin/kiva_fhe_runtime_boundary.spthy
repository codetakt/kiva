theory Kiva_FHE_Runtime_Boundary
begin

rule ConfigureFheRuntimeJob:
  [ Fr(~job) ]
  --[
    FheRuntimeJobConfigured(
      ~job,
      'kiva_fhe_sum_runtime_review_gated_v1',
      'bfv_integer_sum'
    ),
    FheRuntimeBound(~job),
    FheRuntimeExternalReviewCompleted(~job)
  ]->
  [
    !FheRuntimeJob(
      ~job,
      'kiva_fhe_sum_runtime_review_gated_v1',
      'bfv_integer_sum'
    )
  ]

rule AcceptFheRuntimeCiphertextTranscript:
  [ !FheRuntimeJob(job, profile, scheme), Fr(~transcript) ]
  --[
    FheRuntimeParticipantCountMatched(job),
    FheRuntimeParticipantsActive(job),
    FheRuntimeKeyCustodyRecorded(job),
    FheRuntimeParameterSetBound(job),
    FheRuntimeCiphertextTranscriptDigestMatched(job, ~transcript),
    FheRuntimeCiphertextReplayRecordWritten(job, ~transcript),
    FheRuntimeCiphertextTranscriptAccepted(job, ~transcript)
  ]->
  [ !AcceptedFheRuntimeCiphertextTranscript(job, ~transcript) ]

rule AcceptFheRuntimeEvaluation:
  [ !AcceptedFheRuntimeCiphertextTranscript(job, transcript), Fr(~evaluation) ]
  --[
    FheRuntimeAcceptedCiphertextTranscriptUsed(job, transcript),
    FheRuntimeEvaluationProofRecorded(job, transcript, ~evaluation),
    FheRuntimeEvaluationDigestMatched(job, transcript, ~evaluation),
    FheRuntimeEvaluationReplayRecordWritten(job, transcript, ~evaluation),
    FheRuntimeEvaluationAccepted(job, transcript, ~evaluation)
  ]->
  [ !AcceptedFheRuntimeEvaluation(job, transcript, ~evaluation) ]

rule ReleaseFheRuntimeResult:
  [
    !AcceptedFheRuntimeCiphertextTranscript(job, transcript),
    !AcceptedFheRuntimeEvaluation(job, transcript, evaluation),
    Fr(~authority)
  ]
  --[
    FheRuntimeActiveKeyEpoch(job, transcript),
    FheRuntimePolicyApproved(job, transcript, ~authority),
    FheRuntimeGovernedDataProduct(job, transcript),
    FheRuntimeResultReleased(job, transcript, evaluation, ~authority)
  ]->
  [ !ReleasedFheRuntimeResult(job, transcript, evaluation) ]

rule RejectFheRuntimeParameterMismatch:
  [ !FheRuntimeJob(job, profile, scheme) ]
  --[ FheRuntimeParameterMismatchRejected(job, 'parameter_mismatch') ]->
  []

rule RejectFheRuntimeReplay:
  [ !FheRuntimeJob(job, profile, scheme) ]
  --[ FheRuntimeReplayRejected(job, 'replay') ]->
  []

lemma accepted_ciphertext_transcript_requires_configured_job:
  "All job transcript #i.
    FheRuntimeCiphertextTranscriptAccepted(job, transcript) @ #i
    ==>
    Ex profile scheme #j.
      FheRuntimeJobConfigured(job, profile, scheme) @ #j
      & #j < #i"

lemma accepted_ciphertext_transcript_requires_reviewed_runtime:
  "All job transcript #i.
    FheRuntimeCiphertextTranscriptAccepted(job, transcript) @ #i
    ==>
    Ex #j #k.
      FheRuntimeBound(job) @ #j
      & FheRuntimeExternalReviewCompleted(job) @ #k
      & #j < #i
      & #k < #i"

lemma accepted_ciphertext_transcript_requires_custody_and_parameter_binding:
  "All job transcript #i.
    FheRuntimeCiphertextTranscriptAccepted(job, transcript) @ #i
    ==>
    Ex #j #k #l.
      FheRuntimeKeyCustodyRecorded(job) @ #j
      & FheRuntimeParameterSetBound(job) @ #k
      & FheRuntimeCiphertextTranscriptDigestMatched(job, transcript) @ #l
      & #j = #i
      & #k = #i
      & #l = #i"

lemma evaluation_requires_accepted_ciphertext_transcript:
  "All job transcript evaluation #i.
    FheRuntimeEvaluationAccepted(job, transcript, evaluation) @ #i
    ==>
    Ex #j.
      FheRuntimeCiphertextTranscriptAccepted(job, transcript) @ #j
      & #j < #i"

lemma release_requires_accepted_ciphertext_transcript:
  "All job transcript evaluation authority #i.
    FheRuntimeResultReleased(job, transcript, evaluation, authority) @ #i
    ==>
    Ex #j.
      FheRuntimeCiphertextTranscriptAccepted(job, transcript) @ #j
      & #j < #i"

lemma release_requires_prior_evaluation:
  "All job transcript evaluation authority #i.
    FheRuntimeResultReleased(job, transcript, evaluation, authority) @ #i
    ==>
    Ex #j.
      FheRuntimeEvaluationAccepted(job, transcript, evaluation) @ #j
      & #j < #i"

lemma release_requires_policy_approval:
  "All job transcript evaluation authority #i.
    FheRuntimeResultReleased(job, transcript, evaluation, authority) @ #i
    ==>
    Ex #j.
      FheRuntimePolicyApproved(job, transcript, authority) @ #j
      & #j = #i"

lemma release_requires_governed_data_product:
  "All job transcript evaluation authority #i.
    FheRuntimeResultReleased(job, transcript, evaluation, authority) @ #i
    ==>
    Ex #j.
      FheRuntimeGovernedDataProduct(job, transcript) @ #j
      & #j = #i"

lemma plaintext_is_not_publicly_released:
  "not(Ex job plaintext #i. FheRuntimePlaintextPublished(job, plaintext) @ #i)"

lemma decryption_key_is_not_persisted_by_kiva:
  "not(Ex job key #i. FheRuntimeDecryptionKeyPersistedByKiva(job, key) @ #i)"

end
