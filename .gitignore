/result
/result-*
/target/
/artifacts/kani/
__pycache__/
*.py[cod]
/.direnv/
/.pre-commit-config.yaml

# The user-level gitignore on some developer machines ignores all Markdown.
# Keep repository design documents visible so they are included in flake
# sources and evidence validators.
!README.md
!docs/**/*.md
!proofs/**/*.md
!fstar/README.md
!spec/**/*.md

# Reproducible LRS artifacts. Exact inventory and hashes remain tracked in
# spec/conformance/lrs-generated-artifacts{,.lock}.json.
/tests/conformance/http/generated/
/spec/conformance/issued-completion-bindings.json
/spec/conformance/issued-definition-tests.yaml
/spec/conformance/issued-readback-origins.json
/spec/conformance/issued-rejection-origins.json
/spec/conformance/issued-supplemental-tests.yaml
/spec/conformance/lrs-table-bindings.yaml
/spec/conformance/issued-test-projection.json
/spec/conformance/issued-test-matrix.md
/spec/conformance/lrs-assertion-manifest.yaml
/tests/conformance/fixtures/pkix-unicode32.json.gz
/vendor/pkix-path/src/rfc4518/unicode32.rs
